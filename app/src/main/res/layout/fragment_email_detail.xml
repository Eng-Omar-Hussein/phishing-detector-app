<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FROM / TO / DATE -->
        <TextView
            android:id="@+id/tvFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From: sender@example.com"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To: you@example.com"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apr 14, 10:30 AM"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- SUBJECT -->
        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Subject here"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- PHISHING CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipHooked"
            style="@style/Widget.MaterialComponents.Chip.Entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎣 Phishing Detected"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:chipBackgroundColor="@color/red"
            app:chipIconVisible="false"
            app:closeIconVisible="false" />

        <!-- BODY -->
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Full email body goes here..."
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>