<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.emad.phishingdetector.presentation.home.HomeFragment"
        android:label="Inbox"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/nav_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_detail"
        android:name="com.emad.phishingdetector.presentation.detail.EmailDetailFragment"
        android:label="Email Details"
        tools:layout="@layout/fragment_email_detail">
        <argument
            android:name="emailId"
            app:argType="string" />
    </fragment>

</navigation>